//@version=5
// =============================================================================
// ICT Confluence — Run 20 (Order-Block) — Pine port
// =============================================================================
// Faithful-as-reasonable port of the deployed Run 20 config from the TS engine:
//   src/lib/rl/strategies/confluence-scorer.ts  (10-factor weighted scoring)
//   src/lib/rl/strategies/ict-strategies.ts      (order_block detectEntry, dynamic_rr SL/TP)
//   src/lib/ict/{market-structure,order-blocks,fair-value-gaps,liquidity,kill-zones,regime-detector}.ts
//   scripts/backtest-confluence.ts               (exit engine: partial-TP, max-bars, friction)
//
// Run 20 CLI this reproduces:
//   --strategy ob --sl-mode dynamic_rr --friction 0.0007 --threshold 4.048
//   --exit-mode simple --partial-tp "0.50,1.41,0.20" --atr-extension 5.79
//   --ob-half-life 12 --max-bars 160 --cooldown-bars 7
//   --suppress-regime "ranging+normal,ranging+high,downtrend+high"
//   --regime-threshold "uptrend+high:3.14,uptrend+normal:5.74,uptrend+low:5.49,downtrend+normal:4.38,downtrend+low:6.50"
//   --weights structureAlignment:0.1928,killZoneActive:1.2658,liquiditySweep:1.4896,
//             obProximity:2.7262,fvgAtCE:2.3162,recentBOS:2.2229,rrRatio:0.5567,
//             oteZone:1.0621,obFvgConfluence:1.0892,momentumConfirmation:0.0000
//
// CALIBRATION: built for the 3-symbol CRYPTO sleeve (BTC/ETH/SOL) on the 1H chart.
//   volatilityScale = 1.0 is assumed (the TS auto-scaler returns 1.0 for crypto), so
//   proximity = 0.5%, obFvgProximity = 2%, OB impulse = 1.2%. On forex/low-vol symbols
//   the TS scales these up; this port does NOT — apply it to crypto 1H only.
//
// KNOWN DIVERGENCES from the TS backtest (this is a VISUAL gut-check, NOT a number-
// for-number match to the 69.7% WF result):
//   1. Swings use ta.pivothigh/low(7,7) — global rolling, vs the TS 100-bar slice rescan.
//   2. OBs are confirmed 5 bars after formation (forward impulse needs 5 future bars).
//   3. liquiditySweep approximates the TS equal-highs/lows multi-touch detector with a
//      single most-recent-swing sweep (>=0.1% exceedance + close-back reversal, <=10 bars).
//   4. recentBOS = close crossing the most recent confirmed swing (confidence>=0.5 is
//      always true in TS since base confidence is 0.6).
//   5. Partial TP fills at the 1.41R LIMIT intrabar; the TS fills at bar CLOSE once
//      close>=1.41R. Minor timing/price difference on the 50% leg.
//   6. friction 0.0007/side -> commission 0.07%/side (taker both legs).
//   7. fvgAtCE & oteZone weights are inert for OB-only (signal carries no FVG/structureBreak).
//   8. Position sizing here is cosmetic (% of equity, compounding) vs TS fixed-notional.
//   9. Regime needs 500 bars of history (ATR percentile) before it leaves the suppressed
//      "ranging+normal" default — expect no trades in the first ~500 bars.
// =============================================================================

strategy("ICT Confluence Run 20 (OB)", overlay=true, pyramiding=0,
     calc_on_every_tick=false, process_orders_on_close=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.07,
     initial_capital=10000, max_boxes_count=200, max_labels_count=100)

// ----------------------------------------------------------------------------
// Inputs (Run 20 defaults)
// ----------------------------------------------------------------------------
grpW = "Confluence weights (Run 20)"
wStruct  = input.float(0.1928, "structureAlignment", group=grpW)
wKz      = input.float(1.2658, "killZoneActive",     group=grpW)
wSweep   = input.float(1.4896, "liquiditySweep",     group=grpW)
wObProx  = input.float(2.7262, "obProximity",        group=grpW)
wFvgCE   = input.float(2.3162, "fvgAtCE (inert, OB-only)", group=grpW)
wBos     = input.float(2.2229, "recentBOS",          group=grpW)
wRR      = input.float(0.5567, "rrRatio (always 1)", group=grpW)
wOte     = input.float(1.0621, "oteZone (inert, OB-only)", group=grpW)
wObFvg   = input.float(1.0892, "obFvgConfluence",    group=grpW)

grpT = "Thresholds & regime"
baseThr   = input.float(4.048, "Base threshold", group=grpT)
thUpHigh  = input.float(3.14,  "uptrend+high",   group=grpT)
thUpNorm  = input.float(5.74,  "uptrend+normal", group=grpT)
thUpLow   = input.float(5.49,  "uptrend+low",    group=grpT)
thDnNorm  = input.float(4.38,  "downtrend+normal", group=grpT)
thDnLow   = input.float(6.50,  "downtrend+low",  group=grpT)

grpS = "Strategy / exits"
proxPct    = input.float(0.005, "OB touch proximity (frac)", group=grpS)
obFvgProx  = input.float(0.02,  "OB+FVG confluence proximity (frac)", group=grpS)
slMult     = input.float(2.0,   "SL ATR multiple", group=grpS)
tpMult     = input.float(4.0,   "TP ATR multiple (RR = tp/sl)", group=grpS)
obHalfLife = input.float(12.0,  "OB freshness half-life (bars)", group=grpS)
maxEntryAge= input.int(50,      "Max OB age for entry (bars)", group=grpS)
obMaxAge   = input.int(75,      "Max OB age retained (bars)", group=grpS)
fvgMaxAge  = input.int(30,      "Max FVG age retained (bars)", group=grpS)
maxBars    = input.int(160,     "Max bars in trade", group=grpS)
cooldown   = input.int(7,       "Cooldown bars", group=grpS)
atrExtBands= input.float(5.79,  "ATR-extension filter (0=off)", group=grpS)
obImpulsePct = input.float(1.2, "OB impulse min move (%)", group=grpS)
drawBoxes  = input.bool(true,   "Draw OB zones", group=grpS)

// ----------------------------------------------------------------------------
// Core series
// ----------------------------------------------------------------------------
atr14 = ta.sma(ta.tr(true), 14)          // TS uses simple average of TR over 14
sma20 = ta.sma(close, 20)
bodyAbs = math.abs(close - open)

// ----------------------------------------------------------------------------
// Swing structure (lookback 7) -> bias, last swings (for BOS & sweeps)
// market-structure.ts: strict inequality pivots; bias from last 2 HH/HL vs LH/LL
// ----------------------------------------------------------------------------
phP = ta.pivothigh(high, 7, 7)
plP = ta.pivotlow(low, 7, 7)
var float ph1 = na, var float ph2 = na
var float pl1 = na, var float pl2 = na
var float lastPH = na, var float lastPL = na
if not na(phP)
    ph1 := ph2
    ph2 := phP
    lastPH := phP
if not na(plP)
    pl1 := pl2
    pl2 := plP
    lastPL := plP

int bias = 0   // 1 bullish, -1 bearish, 0 neutral
if not na(ph1) and not na(ph2) and not na(pl1) and not na(pl2)
    if ph2 > ph1 and pl2 > pl1
        bias := 1
    else if ph2 < ph1 and pl2 < pl1
        bias := -1

// BOS: close breaks most-recent confirmed swing (TS confidence>=0.5 always holds)
var int bullBOSbar = na, var int bearBOSbar = na
if not na(lastPH) and close > lastPH and close[1] <= lastPH
    bullBOSbar := bar_index
if not na(lastPL) and close < lastPL and close[1] >= lastPL
    bearBOSbar := bar_index

// Liquidity sweeps (approx): SSL sweep favors longs, BSL sweep favors shorts
var int sslBar = na, var int bslBar = na
if not na(lastPL) and low < lastPL and (lastPL - low) >= close * 0.001 and close >= lastPL * 0.999
    sslBar := bar_index
if not na(lastPH) and high > lastPH and (high - lastPH) >= close * 0.001 and close <= lastPH * 1.001
    bslBar := bar_index

// ----------------------------------------------------------------------------
// Kill zones (kill-zones.ts) — NY/Eastern local hours, weekends excluded
// ----------------------------------------------------------------------------
nyHour = hour(time, "America/New_York")
nyDow  = dayofweek(time, "America/New_York")
bool weekend = nyDow == dayofweek.saturday or nyDow == dayofweek.sunday
int kzPri = 0
if not weekend
    if nyHour >= 2 and nyHour < 5
        kzPri := 3        // London Open
    else if nyHour >= 8 and nyHour < 11
        kzPri := 3        // NY Open (takes precedence over London Close at 10:00)
    else if nyHour >= 10 and nyHour < 12
        kzPri := 2        // London Close (effectively hour 11)
    else if nyHour >= 20 and nyHour < 24
        kzPri := 1        // Asian
float killZoneRaw = kzPri == 3 ? 1.0 : kzPri == 2 ? 0.7 : kzPri == 1 ? 0.3 : 0.0

// ----------------------------------------------------------------------------
// Regime detector (regime-detector.ts) -> label "<trend>+<vol>"
// ----------------------------------------------------------------------------
float totalPath = math.sum(math.abs(close - close[1]), 100)
float eff = (not na(close[100]) and totalPath > 0) ? math.abs(close - close[100]) / totalPath : na

upMove   = high - high[1]
downMove = low[1] - low
plusDM   = (upMove > downMove and upMove > 0)     ? upMove   : 0.0
minusDM  = (downMove > upMove and downMove > 0)   ? downMove : 0.0
sumPlus  = math.sum(plusDM, 14)
sumMinus = math.sum(minusDM, 14)
totalDM  = sumPlus + sumMinus
float di = totalDM > 0 ? math.abs(sumPlus - sumMinus) / totalDM : 0.0

float slope = na
if not na(close[100])
    pc = close - close[100]
    ap = (close[100] + close) / 2
    slope := math.max(-1.0, math.min(1.0, (pc / (ap * 100)) * 1000))

float atrPct    = atr14 / close
float atrPctile = ta.percentrank(atrPct, 500) / 100.0
float tStr      = (not na(eff) and not na(slope)) ? (eff + di + math.abs(slope)) / 3.0 : na

string trendC = "ranging"
if not na(eff) and not na(tStr) and not na(slope)
    if eff < 0.25 and tStr < 0.3
        trendC := "ranging"
    else if eff >= 0.40 or tStr >= 0.4
        trendC := slope >= 0 ? "uptrend" : "downtrend"
    else
        trendC := math.abs(slope) > 0.3 ? (slope > 0 ? "uptrend" : "downtrend") : "ranging"

string volC = not na(atrPctile) ? (atrPctile >= 0.75 ? "high" : atrPctile <= 0.25 ? "low" : "normal") : "normal"

bool regimeReady = not na(eff) and not na(slope) and not na(atrPctile) and not na(tStr)
string regimeLbl = regimeReady ? trendC + "+" + volC : "ranging+normal"

bool suppressed = regimeLbl == "ranging+normal" or regimeLbl == "ranging+high" or regimeLbl == "downtrend+high"

float effThr = baseThr
if regimeLbl == "uptrend+high"
    effThr := thUpHigh
else if regimeLbl == "uptrend+normal"
    effThr := thUpNorm
else if regimeLbl == "uptrend+low"
    effThr := thUpLow
else if regimeLbl == "downtrend+normal"
    effThr := thDnNorm
else if regimeLbl == "downtrend+low"
    effThr := thDnLow

// ----------------------------------------------------------------------------
// Order blocks (order-blocks.ts) — detected with 5-bar forward confirmation
// ----------------------------------------------------------------------------
type Zone
    float top
    float bot
    int   bornBar
    int   dir     // 1 bullish, -1 bearish
    bool  dead

var array<Zone> obs  = array.new<Zone>()
var array<Zone> fvgs = array.new<Zone>()

f_bull(k) => math.max(0.0, close[k] - open[k])
f_bear(k) => math.max(0.0, open[k] - close[k])

if bar_index > 12
    float thr = close[5] * (obImpulsePct / 100.0)
    float rng5 = high[5] - low[5]
    // ---- Bullish OB: bearish candle (body/range>=0.5) before bullish impulse ----
    bool candBull = close[5] < open[5] and rng5 > 0 and (open[5] - close[5]) / rng5 >= 0.5
    bool next2Bull = (close[4] > open[4]) or (close[3] > open[3])
    bool rejBull = close[4] < open[4] and (open[4] - close[4]) > (open[5] - close[5])
    float moveBull = f_bull(4) + f_bull(3) + f_bull(2) + f_bull(1) + f_bull(0)
    if candBull and next2Bull and not rejBull and moveBull >= thr
        array.push(obs, Zone.new(high[5], low[5], bar_index - 5, 1, false))
        if drawBoxes
            box.new(bar_index - 5, high[5], bar_index + 30, low[5], border_color=color.new(color.teal, 40), bgcolor=color.new(color.teal, 88))
    // ---- Bearish OB: bullish candle (body/range>=0.5) before bearish impulse ----
    bool candBear = close[5] > open[5] and rng5 > 0 and (close[5] - open[5]) / rng5 >= 0.5
    bool next2Bear = (close[4] < open[4]) or (close[3] < open[3])
    bool rejBear = close[4] > open[4] and (close[4] - open[4]) > (close[5] - open[5])
    float moveBear = f_bear(4) + f_bear(3) + f_bear(2) + f_bear(1) + f_bear(0)
    if candBear and next2Bear and not rejBear and moveBear >= thr
        array.push(obs, Zone.new(high[5], low[5], bar_index - 5, -1, false))
        if drawBoxes
            box.new(bar_index - 5, high[5], bar_index + 30, low[5], border_color=color.new(color.maroon, 40), bgcolor=color.new(color.maroon, 88))

// Mitigation: bullish OB dies when price trades into it (low<=top); bearish when high>=bot
if array.size(obs) > 0
    for i = 0 to array.size(obs) - 1
        Zone z = array.get(obs, i)
        if not z.dead
            if z.dir == 1 and low <= z.top
                z.dead := true
            else if z.dir == -1 and high >= z.bot
                z.dead := true

// ----------------------------------------------------------------------------
// Fair value gaps (fair-value-gaps.ts) — 3-candle gap + displacement
// (used only by the obFvgConfluence factor for OB-only Run 20)
// ----------------------------------------------------------------------------
float avgBody = ta.sma(bodyAbs, 14)[2]
bool dispMid = not na(avgBody) and math.abs(close[1] - open[1]) > 1.5 * avgBody
float minGap = close[1] * (0.4 / 100.0)
if bar_index > 3 and dispMid
    // Bullish FVG: candle3.low > candle1.high
    if low > high[2] and (low - high[2]) >= minGap
        array.push(fvgs, Zone.new(low, high[2], bar_index - 1, 1, false))
    // Bearish FVG: candle3.high < candle1.low
    if high[0] < low[2] and (low[2] - high[0]) >= minGap
        array.push(fvgs, Zone.new(low[2], high[0], bar_index - 1, -1, false))

// FVG fill: bullish filled when low<=bot; bearish when high>=top
if array.size(fvgs) > 0
    for i = 0 to array.size(fvgs) - 1
        Zone f = array.get(fvgs, i)
        if not f.dead
            if f.dir == 1 and low <= f.bot
                f.dead := true
            else if f.dir == -1 and high >= f.top
                f.dead := true

// ----------------------------------------------------------------------------
// obFvgConfluence: unmitigated OB AND unfilled FVG near price, aligned w/ direction
// ----------------------------------------------------------------------------
f_obNear(int wantDir) =>
    bool hit = false
    if array.size(obs) > 0
        for i = 0 to array.size(obs) - 1
            Zone z = array.get(obs, i)
            if not z.dead and z.dir == wantDir
                float lvl = wantDir == 1 ? z.top : z.bot
                if math.abs(close - lvl) / close <= obFvgProx
                    hit := true
    hit

f_fvgNear(int wantDir) =>
    bool hit = false
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            Zone f = array.get(fvgs, i)
            if not f.dead and f.dir == wantDir
                float lvl = wantDir == 1 ? f.top : f.bot
                if math.abs(close - lvl) / close <= obFvgProx
                    hit := true
    hit

bool longConfl  = f_obNear(1)  and f_fvgNear(1)
bool shortConfl = f_obNear(-1) and f_fvgNear(-1)

// ----------------------------------------------------------------------------
// Entry selection: first (oldest) qualifying unmitigated OB price is touching,
// with reaction confirmation + trend filter (bias != opposite).  detectEntry().
// ----------------------------------------------------------------------------
float prox = proxPct  // crypto volatilityScale = 1.0
int   chDir  = 0
float chTop  = na
float chBot  = na
int   chBorn = na

if strategy.position_size == 0 and array.size(obs) > 0
    for i = 0 to array.size(obs) - 1
        if chDir == 0
            Zone z = array.get(obs, i)
            int age = bar_index - z.bornBar
            if not z.dead and age <= maxEntryAge
                float rng = high - low
                float mid = (z.bot + z.top) / 2
                if z.dir == 1
                    float tzT = z.top * (1 + prox)
                    float tzB = z.bot * (1 - prox)
                    if low <= tzT and low >= tzB and close > mid and rng > 0 and bodyAbs / rng >= 0.4 and bias != -1
                        chDir := 1
                        chTop := z.top
                        chBot := z.bot
                        chBorn := z.bornBar
                else
                    float tzT = z.top * (1 + prox)
                    float tzB = z.bot * (1 - prox)
                    if high >= tzB and high <= tzT and close < mid and rng > 0 and bodyAbs / rng >= 0.4 and bias != 1
                        chDir := -1
                        chTop := z.top
                        chBot := z.bot
                        chBorn := z.bornBar

// ----------------------------------------------------------------------------
// Confluence score for the chosen signal (OB-only Run 20 active factors)
// ----------------------------------------------------------------------------
float score = na
if chDir != 0
    int age = bar_index - chBorn
    float fObProx = age < 100 ? math.exp(-age / obHalfLife) : 0.0
    float fStruct = (chDir == 1 and bias == 1) or (chDir == -1 and bias == -1) ? 1.0 : 0.0
    float fSweep  = chDir == 1 ? (not na(sslBar) and bar_index - sslBar <= 10 ? 1.0 : 0.0) : (not na(bslBar) and bar_index - bslBar <= 10 ? 1.0 : 0.0)
    float fBos    = chDir == 1 ? (not na(bullBOSbar) and bar_index - bullBOSbar <= 30 ? 1.0 : 0.0) : (not na(bearBOSbar) and bar_index - bearBOSbar <= 30 ? 1.0 : 0.0)
    float fObFvg  = chDir == 1 ? (longConfl ? 1.0 : 0.0) : (shortConfl ? 1.0 : 0.0)
    // rrRatio is always 1.0 (dynamic_rr makes RR exactly tp/sl = 2.0 >= minRR 2.0)
    score := wRR * 1.0 + wStruct * fStruct + wKz * killZoneRaw + wSweep * fSweep + wObProx * fObProx + wBos * fBos + wObFvg * fObFvg
    // fvgAtCE (wFvgCE) and oteZone (wOte) are structurally 0 for OB signals.

// ----------------------------------------------------------------------------
// Filters & entry
// ----------------------------------------------------------------------------
bool extended = atrExtBands > 0 and not na(sma20) and math.abs(close - sma20) > atr14 * atrExtBands
var int lastEntryBar = na
bool cdOk = na(lastEntryBar) or (bar_index - lastEntryBar) >= cooldown

bool canEnter = strategy.position_size == 0 and chDir != 0 and not suppressed and not extended and cdOk and not na(score) and score >= effThr

var float vEntry = na, var float vSL = na, var float vTP1 = na, var float vTP2 = na, var float vBE = na
var int vEntryBar = na
var bool vPartial = false

if canEnter
    float entry = close
    if chDir == 1
        float sl = chBot - atr14 * slMult
        float risk = entry - sl
        vEntry := entry
        vSL := sl
        vRisk = risk
        vTP1 := entry + risk * 1.41
        vTP2 := entry + risk * (tpMult / slMult)
        vBE := entry + risk * 0.20
        strategy.entry("L", strategy.long)
    else
        float sl = chTop + atr14 * slMult
        float risk = sl - entry
        vEntry := entry
        vSL := sl
        vTP1 := entry - risk * 1.41
        vTP2 := entry - risk * (tpMult / slMult)
        vBE := entry - risk * 0.20
        strategy.entry("S", strategy.short)
    vEntryBar := bar_index
    vPartial := false

// ----------------------------------------------------------------------------
// Exit management: 50% partial @1.41R -> move stop to BE+0.20R; runner -> 2R / SL / max-bars
// ----------------------------------------------------------------------------
if strategy.position_size > 0
    float curStop = vPartial ? vBE : vSL
    if not vPartial
        strategy.exit("L-tp1", from_entry="L", qty_percent=50, stop=curStop, limit=vTP1)
    strategy.exit("L-run", from_entry="L", stop=curStop, limit=vTP2)
    if not vPartial and high >= vTP1
        vPartial := true
    if bar_index - vEntryBar >= maxBars
        strategy.close("L", comment="max_bars")

if strategy.position_size < 0
    float curStop = vPartial ? vBE : vSL
    if not vPartial
        strategy.exit("S-tp1", from_entry="S", qty_percent=50, stop=curStop, limit=vTP1)
    strategy.exit("S-run", from_entry="S", stop=curStop, limit=vTP2)
    if not vPartial and low <= vTP1
        vPartial := true
    if bar_index - vEntryBar >= maxBars
        strategy.close("S", comment="max_bars")

// ----------------------------------------------------------------------------
// Prune stale zones to bound array growth
// ----------------------------------------------------------------------------
while array.size(obs) > 0 and bar_index - array.get(obs, 0).bornBar > obMaxAge
    array.shift(obs)
while array.size(fvgs) > 0 and bar_index - array.get(fvgs, 0).bornBar > fvgMaxAge
    array.shift(fvgs)

// ----------------------------------------------------------------------------
// Info panel
// ----------------------------------------------------------------------------
var table tbl = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "Regime",      text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 0, regimeLbl + (suppressed ? " (suppressed)" : ""), text_color=suppressed ? color.red : color.green, text_size=size.small)
    table.cell(tbl, 0, 1, "Threshold",   text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(effThr, "#.##"), text_size=size.small)
    table.cell(tbl, 0, 2, "Bias",        text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 2, bias == 1 ? "bullish" : bias == -1 ? "bearish" : "neutral", text_size=size.small)
    table.cell(tbl, 0, 3, "Last score",  text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 3, na(score) ? "-" : str.tostring(score, "#.##"), text_size=size.small)
    table.cell(tbl, 0, 4, "ATR ext?",    text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 4, extended ? "yes" : "no", text_color=extended ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 0, 5, "Open OBs",    text_color=color.gray, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(array.size(obs)), text_size=size.small)
